---
import Base from '../layouts/Base.astro';
---

<Base>
  <div class="max-w-4xl mx-auto px-4 py-10 sm:py-16">

    <!-- Hero -->
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400 text-sm font-medium px-3 py-1.5 rounded-full mb-5">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
        Free · No signup · No jargon
      </div>
      <h1 class="font-display text-4xl sm:text-5xl font-extrabold text-gray-900 dark:text-white tracking-tight mb-4">
        TV Size Calculator
      </h1>
      <p class="text-lg text-gray-500 dark:text-gray-400 max-w-md mx-auto">
        Tell us how far you sit. We'll tell you exactly which TV to buy.
      </p>
    </div>

    <!-- TV Illustration -->
    <div class="flex justify-center mb-12 select-none" aria-hidden="true">
      <svg viewBox="0 0 420 160" class="w-full max-w-sm" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Floor line -->
        <line x1="0" y1="148" x2="420" y2="148" stroke="#E5E7EB" stroke-width="1.5" class="dark:stroke-gray-700"/>
        <!-- TV stand -->
        <rect x="182" y="128" width="56" height="10" rx="3" fill="#D1D5DB" class="dark:fill-gray-700"/>
        <rect x="200" y="115" width="20" height="16" rx="2" fill="#D1D5DB" class="dark:fill-gray-700"/>
        <!-- TV body -->
        <rect x="100" y="30" width="220" height="90" rx="8" fill="#1E293B" class="dark:fill-gray-800"/>
        <!-- TV screen -->
        <rect x="108" y="38" width="204" height="74" rx="5" fill="#0F172A" class="dark:fill-gray-900"/>
        <!-- Screen content glow -->
        <rect x="112" y="42" width="196" height="66" rx="4" fill="#1E3A5F" opacity="0.8"/>
        <!-- TV icon on screen -->
        <text x="210" y="82" text-anchor="middle" font-size="28" fill="#3B82F6" opacity="0.7">📺</text>

        <!-- Person silhouette -->
        <circle cx="358" cy="90" r="13" fill="#9CA3AF" class="dark:fill-gray-600"/>
        <rect x="346" y="105" width="24" height="32" rx="5" fill="#9CA3AF" class="dark:fill-gray-600"/>
        <rect x="338" y="108" width="12" height="20" rx="4" fill="#9CA3AF" class="dark:fill-gray-600"/>
        <rect x="370" y="108" width="12" height="20" rx="4" fill="#9CA3AF" class="dark:fill-gray-600"/>
        <rect x="348" y="137" width="10" height="12" rx="4" fill="#9CA3AF" class="dark:fill-gray-600"/>
        <rect x="362" y="137" width="10" height="12" rx="4" fill="#9CA3AF" class="dark:fill-gray-600"/>

        <!-- Distance arrow + label -->
        <line x1="322" y1="115" x2="326" y2="115" stroke="#3B82F6" stroke-width="1.5" stroke-dasharray="3,3"/>
        <line x1="326" y1="115" x2="340" y2="115" stroke="#3B82F6" stroke-width="1.5" stroke-dasharray="3,3"/>
        <line x1="316" y1="115" x2="320" y2="115" stroke="#3B82F6" stroke-width="1.5"/>
        <text x="318" y="110" text-anchor="middle" font-size="9" fill="#3B82F6" font-family="Inter,sans-serif">distance</text>
      </svg>
    </div>

    <!-- Mode Toggle -->
    <div class="flex justify-center mb-8">
      <div class="bg-gray-100 dark:bg-gray-800 p-1 rounded-xl inline-flex gap-1">
        <button
          id="mode-distance"
          class="mode-btn active-mode px-5 py-2 rounded-lg text-sm font-semibold transition-all duration-200"
          onclick="switchMode('distance')"
        >
          📏 I know my distance
        </button>
        <button
          id="mode-size"
          class="mode-btn inactive-mode px-5 py-2 rounded-lg text-sm font-semibold transition-all duration-200"
          onclick="switchMode('size')"
        >
          📺 I know my TV size
        </button>
      </div>
    </div>

    <!-- Calculator Card -->
    <div class="max-w-lg mx-auto">
      <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-800 p-6 sm:p-8">

        <!-- MODE 1: Distance → Size -->
        <div id="panel-distance">
          <div class="mb-6">
            <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">
              How far do you sit from your TV?
            </label>
            <div class="flex items-center gap-3">
              <input
                type="number"
                id="distance-input"
                min="3" max="25" value="8"
                class="calc-input w-28 text-center text-xl font-bold"
                oninput="syncSlider(this.value)"
              />
              <span class="text-gray-500 dark:text-gray-400 font-medium">feet</span>
            </div>
            <input
              type="range"
              id="distance-slider"
              min="3" max="25" value="8" step="0.5"
              class="mt-4 w-full accent-blue-500"
              oninput="syncInput(this.value)"
            />
            <div class="flex justify-between text-xs text-gray-400 mt-1">
              <span>3 ft</span>
              <span>~couch distance</span>
              <span>25 ft</span>
            </div>
          </div>

          <div class="mb-6">
            <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">
              TV type?
            </label>
            <select id="tv-type" class="calc-input w-full text-base">
              <option value="4k">4K Ultra HD (most TVs today)</option>
              <option value="1080p">1080p Full HD (older TV)</option>
            </select>
          </div>

          <button
            onclick="calculateSize()"
            class="w-full bg-green-500 hover:bg-green-600 active:scale-95 text-white font-bold text-base py-4 rounded-xl transition-all duration-150 shadow-sm shadow-green-200 dark:shadow-green-900/30"
          >
            Find My Perfect TV Size →
          </button>

          <!-- Result: Mode 1 -->
          <div id="result-distance" class="hidden mt-6 pt-6 border-t border-gray-100 dark:border-gray-800">
            <div class="text-center">
              <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">Best TV for your room</p>
              <p id="result-primary" class="font-display text-5xl font-extrabold text-green-500 mb-2"></p>
              <p id="result-subtitle" class="text-sm text-gray-500 dark:text-gray-400 mb-4"></p>
              <div class="bg-gray-50 dark:bg-gray-800 rounded-xl px-4 py-3">
                <p class="text-xs text-gray-400 mb-1">Also good</p>
                <p id="result-alternatives" class="text-sm font-semibold text-gray-600 dark:text-gray-300"></p>
              </div>
            </div>
          </div>
        </div>

        <!-- MODE 2: Size → Distance -->
        <div id="panel-size" class="hidden">
          <div class="mb-6">
            <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">
              What TV size are you looking at?
            </label>
            <div class="flex items-center gap-3">
              <input
                type="number"
                id="size-input"
                min="24" max="120" value="55"
                class="calc-input w-28 text-center text-xl font-bold"
              />
              <span class="text-gray-500 dark:text-gray-400 font-medium">inches</span>
            </div>
            <p class="text-xs text-gray-400 mt-2">Common sizes: 43, 50, 55, 65, 75, 85 inches</p>
          </div>

          <button
            onclick="calculateDistance()"
            class="w-full bg-blue-500 hover:bg-blue-600 active:scale-95 text-white font-bold text-base py-4 rounded-xl transition-all duration-150 shadow-sm shadow-blue-200 dark:shadow-blue-900/30"
          >
            Find My Perfect Sitting Distance →
          </button>

          <!-- Result: Mode 2 -->
          <div id="result-size" class="hidden mt-6 pt-6 border-t border-gray-100 dark:border-gray-800">
            <div class="text-center">
              <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">Best sitting distance</p>
              <p id="result-distance-primary" class="font-display text-5xl font-extrabold text-blue-500 mb-2"></p>
              <p id="result-distance-subtitle" class="text-sm text-gray-500 dark:text-gray-400 mb-4"></p>
              <div class="bg-gray-50 dark:bg-gray-800 rounded-xl px-4 py-3">
                <p class="text-xs text-gray-400 mb-1">Acceptable range</p>
                <p id="result-distance-range" class="text-sm font-semibold text-gray-600 dark:text-gray-300"></p>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Trust nudge -->
      <p class="text-center text-xs text-gray-400 dark:text-gray-600 mt-4">
        Based on standard viewing angle guidelines · No account needed
      </p>
    </div>

    <!-- Quick answers -->
    <div class="mt-16 max-w-2xl mx-auto">
      <h2 class="text-center font-display font-bold text-xl text-gray-800 dark:text-gray-200 mb-6">Quick answers</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        {[
          { dist: 6, label: "6 ft away" },
          { dist: 7, label: "7 ft away" },
          { dist: 8, label: "8 ft away" },
          { dist: 10, label: "10 ft away" },
          { dist: 12, label: "12 ft away" },
          { dist: 15, label: "15 ft away" },
        ].map(({ dist, label }) => {
          const size = Math.round((dist * 7.5) / 5) * 5;
          const common = [43, 50, 55, 60, 65, 75, 85];
          const nearest = common.reduce((a, b) => Math.abs(b - size) < Math.abs(a - size) ? b : a);
          return (
            <div class="bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800 px-4 py-3 text-center">
              <p class="text-xs text-gray-400 mb-1">{label}</p>
              <p class="font-display font-extrabold text-2xl text-green-500">{nearest}"</p>
              <p class="text-xs text-gray-400 mt-0.5">4K TV</p>
            </div>
          );
        })}
      </div>
    </div>

  </div>
</Base>

<style>
  .calc-input {
    @apply border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 rounded-xl px-4 py-3 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all;
  }
  .active-mode {
    @apply bg-white dark:bg-gray-700 text-gray-900 dark:text-white shadow-sm;
  }
  .inactive-mode {
    @apply text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200;
  }
</style>

<script is:inline>
  const COMMON_SIZES = [43, 50, 55, 60, 65, 75, 85];

  function nearestSize(inches) {
    return COMMON_SIZES.reduce((a, b) =>
      Math.abs(b - inches) < Math.abs(a - inches) ? b : a
    );
  }

  function switchMode(mode) {
    const panelDist = document.getElementById('panel-distance');
    const panelSize = document.getElementById('panel-size');
    const btnDist   = document.getElementById('mode-distance');
    const btnSize   = document.getElementById('mode-size');

    if (mode === 'distance') {
      panelDist.classList.remove('hidden');
      panelSize.classList.add('hidden');
      btnDist.classList.add('active-mode');
      btnDist.classList.remove('inactive-mode');
      btnSize.classList.remove('active-mode');
      btnSize.classList.add('inactive-mode');
    } else {
      panelSize.classList.remove('hidden');
      panelDist.classList.add('hidden');
      btnSize.classList.add('active-mode');
      btnSize.classList.remove('inactive-mode');
      btnDist.classList.remove('active-mode');
      btnDist.classList.add('inactive-mode');
    }
  }

  function syncSlider(val) {
    const s = document.getElementById('distance-slider');
    if (s) s.value = val;
  }

  function syncInput(val) {
    const i = document.getElementById('distance-input');
    if (i) i.value = val;
  }

  function calculateSize() {
    const dist   = parseFloat(document.getElementById('distance-input').value) || 8;
    const type   = document.getElementById('tv-type').value;
    const mult   = type === '4k' ? 7.5 : 5.5;
    const raw    = dist * mult;
    const best   = nearestSize(raw);

    const idx    = COMMON_SIZES.indexOf(best);
    const alts   = [];
    if (idx > 0)                    alts.push(COMMON_SIZES[idx - 1] + '"');
    if (idx < COMMON_SIZES.length - 1) alts.push(COMMON_SIZES[idx + 1] + '"');

    document.getElementById('result-primary').textContent = best + ' inch TV';
    document.getElementById('result-subtitle').textContent =
      `For a ${type.toUpperCase()} TV at ${dist} ft — ${best}" gives you the perfect picture`;
    document.getElementById('result-alternatives').textContent =
      alts.length ? alts.join(' or ') + ' also work great' : 'This size is ideal for your room';

    const r = document.getElementById('result-distance');
    r.classList.remove('hidden');
    r.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function calculateDistance() {
    const size    = parseFloat(document.getElementById('size-input').value) || 55;
    const ideal   = size / 7.5;
    const minDist = size / 9.5;
    const maxDist = size / 5.5;

    document.getElementById('result-distance-primary').textContent =
      ideal.toFixed(1) + ' feet away';
    document.getElementById('result-distance-subtitle').textContent =
      `Sit about ${ideal.toFixed(1)} ft from your ${size}" TV for the best experience`;
    document.getElementById('result-distance-range').textContent =
      `Min: ${minDist.toFixed(1)} ft  ·  Max: ${maxDist.toFixed(1)} ft`;

    const r = document.getElementById('result-size');
    r.classList.remove('hidden');
    r.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }
</script>
